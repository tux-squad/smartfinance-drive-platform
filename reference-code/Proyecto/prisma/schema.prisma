generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "auth"]
}

model Profile {
  id               String    @id @db.Uuid
  email            String
  nationalId       String?   @map("national_id")
  fullLegalNames   String?   @map("full_legal_names")
  dateOfBirth      DateTime? @map("date_of_birth") @db.Date
  phoneCountryCode String?   @default("+51") @map("phone_country_code")
  mobilePhone      String?   @map("mobile_phone")
  monthlyIncome    Decimal?  @map("monthly_income") @db.Decimal(12, 2)
  employmentStatus String?   @map("employment_status")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("profiles")
  @@schema("public")
}

model FinancialEntity {
  id             String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String                         @unique
  createdAt      DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  vehicles       Vehicle[]
  rateBenchmarks FinancialEntityRateBenchmark[]

  @@map("financial_entities")
  @@schema("public")
}

model Vehicle {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String          @map("user_id") @db.Uuid
  financialEntityId String          @map("financial_entity_id") @db.Uuid
  brand             String
  model             String
  manufactureYear   Int             @map("manufacture_year")
  condition         String
  currency          String
  imagePath         String?         @map("image_path")
  price             Decimal         @db.Decimal(12, 2)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  financialEntity   FinancialEntity @relation(fields: [financialEntityId], references: [id])
  simulations       Simulation[]

  @@map("vehicles")
  @@schema("public")
}

model Simulation {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  vehicleId      String?   @map("vehicle_id") @db.Uuid
  clientName     String    @default("Client") @map("client_name")
  vehicleLabel   String    @default("Unknown Vehicle") @map("vehicle_label")
  currency       String    @default("PEN")
  downPayment    Decimal   @default(0) @map("down_payment") @db.Decimal(12, 2)
  balloonFee     Decimal   @default(0) @map("balloon_fee") @db.Decimal(12, 2)
  gracePeriod    Int       @default(0) @map("grace_period_months")
  term           Int       @default(1) @map("term_months")
  isCapital      Boolean   @default(false) @map("is_capitalized")
  annualRate     Decimal   @default(0) @map("annual_rate") @db.Decimal(9, 6)
  rateType       String    @default("effective") @map("rate_type")
  compounding    Int       @default(12)
  insuranceRate  Decimal   @default(0) @map("insurance_rate") @db.Decimal(9, 6)
  amountFinanced Decimal   @default(0) @map("amount_financed") @db.Decimal(12, 2)
  monthlyPayment Decimal   @default(0) @map("monthly_payment") @db.Decimal(12, 2)
  tcea           Decimal   @default(0) @db.Decimal(9, 6)
  tir            Decimal   @default(0) @db.Decimal(9, 6)
  van            Decimal   @default(0) @db.Decimal(12, 2)
  status         String    @default("pending")
  simulatedAt    DateTime  @default(now()) @map("simulated_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  vehicle        Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  paymentSchedules PaymentSchedule[]

  @@map("simulations")
  @@schema("public")
}

model PaymentSchedule {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  simulationId   String     @map("simulation_id") @db.Uuid
  periodNumber   Int        @map("period_number")
  dueDate        DateTime   @map("due_date") @db.Date
  openingBalance Decimal    @map("opening_balance") @db.Decimal(12, 2)
  interest       Decimal    @db.Decimal(12, 2)
  principal      Decimal    @db.Decimal(12, 2)
  insurance      Decimal    @default(0) @db.Decimal(12, 2)
  commission     Decimal    @default(0) @db.Decimal(12, 2)
  totalPayment   Decimal    @map("total_payment") @db.Decimal(12, 2)
  cashFlow       Decimal    @map("cash_flow") @db.Decimal(12, 2)
  closingBalance Decimal    @map("closing_balance") @db.Decimal(12, 2)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  simulation     Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@unique([simulationId, periodNumber], map: "payment_schedules_simulation_period_unique")
  @@index([simulationId], map: "payment_schedules_simulation_id_idx")
  @@index([dueDate], map: "payment_schedules_due_date_idx")
  @@map("payment_schedules")
  @@schema("public")
}

model FinancialEntityRateBenchmark {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  financialEntityId String          @map("financial_entity_id") @db.Uuid
  rateType          String          @default("TCEA") @map("rate_type")
  annualRate        Decimal         @map("annual_rate") @db.Decimal(9, 6)
  currency          String
  sourceLabel       String          @map("source_label")
  sourceUrl         String?         @map("source_url")
  effectiveFrom     DateTime        @map("effective_from") @db.Date
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  financialEntity   FinancialEntity @relation(fields: [financialEntityId], references: [id], onDelete: Cascade)

  @@unique([financialEntityId, rateType, currency, effectiveFrom], map: "financial_entity_rate_benchmarks_unique")
  @@index([financialEntityId], map: "financial_entity_rate_benchmarks_entity_id_idx")
  @@map("financial_entity_rate_benchmarks")
  @@schema("public")
}
